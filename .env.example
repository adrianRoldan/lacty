# Copia este archivo como .env y rellena los valores

# Secreto de sesión (genera uno con: openssl rand -hex 32)
SESSION_SECRET=cambia_esto_por_un_secreto_largo

# Claves VAPID para push notifications
# Si las dejas vacías, el servidor las genera automáticamente en /app/data
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
