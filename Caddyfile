# Configuración de referencia de Caddy para Lacty.
#
# OJO: el Caddy de producción vive en /etc/caddy/Caddyfile y aloja también
# otros sitios (p. ej. diety.lacty.es) que NO aparecen aquí. No sobrescribas
# ese fichero con este: aplica los cambios que necesites y recarga con
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

# ── Landing (lacty.es) ────────────────────────────────────────────────────────
lacty.es {
    root * /opt/lacty/landing
    encode zstd gzip
    file_server

    # Iconos e imagen social: cambian muy de vez en cuando.
    @imagenes path *.png *.jpg *.svg *.ico *.woff2
    header @imagenes Cache-Control "public, max-age=604800"

    # styles.css no lleva hash en el nombre, así que no puede cachearse como
    # immutable: un cambio se quedaría congelado en los navegadores que ya
    # hubieran visitado la web. Con una hora basta.
    @css path *.css
    header @css Cache-Control "public, max-age=3600"

    # El HTML se revalida siempre, para que los cambios se vean al desplegar.
    @html path *.html /
    header @html Cache-Control "public, max-age=0, must-revalidate"

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# SEO: lacty.es y www.lacty.es compartían bloque y servían el mismo contenido
# con un 200 (contenido duplicado). Separándolos, este 301 concentra toda la
# autoridad en el dominio canónico, el mismo que declara <link rel=canonical>.
www.lacty.es {
    redir https://lacty.es{uri} permanent
}

# ── Aplicación (app.lacty.es) ─────────────────────────────────────────────────
app.lacty.es {
    reverse_proxy localhost:3001
}
